<% compact = local_assigns.fetch(:compact, false) %>
<% title_resolution = local_assigns[:title_resolution] || admin_original_song_assignment_track_title_resolution(track, local_assigns[:title_resolutions]) %>
<% display_album_name = title_resolution&.display_album_name || track.jan_code %>
<% display_track_name = title_resolution&.display_track_name(track) || track.isrc %>
<% display_album_value = admin_record_image_url(track).present? ? admin_value_with_thumbnail(track, display_album_name) : display_album_name %>
<% selected_original_songs = track.original_songs.sort_by { |song| [song.original_code, song.track_number, song.code] } %>
<% selected_options = selected_original_songs.map do |song| %>
  <% { value: song.code, label: [song.code, song.title, song.original_title].compact_blank.uniq.join(' / ') } %>
<% end %>
<% original_song_listbox_id = "admin-original-song-options-#{track.id}" %>

<tr data-controller="admin-original-song-picker"
    data-admin-original-song-picker-url-value="<%= admin_track_original_song_assignment_options_path %>"
    data-admin-original-song-picker-resolve-url-value="<%= admin_resolve_track_original_song_assignments_path %>"
    data-admin-original-song-picker-error-text-value="<%= t('admin.original_song_assignments.search_load_error') %>"
    data-admin-original-song-picker-retry-text-value="<%= t('admin.original_song_assignments.search_retry') %>"
    data-admin-original-song-picker-initial-options-value="<%= json_escape(selected_options.to_json) %>">
  <% unless compact %>
    <td class="admin-original-song-assignment-circle-cell"><%= admin_display_value(track_resource, track, :circle_name) %></td>
    <td class="admin-original-song-assignment-album-cell">
      <%= admin_copyable_original_song_assignment_resolved_value(
            display_album_name,
            label: t('admin.original_song_assignments.album_name'),
            display_value: display_album_value
          ) %>
    </td>
  <% end %>
  <td class="admin-original-song-assignment-track-number-cell">
    <%= admin_original_song_assignment_track_number(track) || tag.span(t('admin.shared.blank'), class: 'admin-muted-text') %>
  </td>
  <td class="admin-original-song-assignment-track-name-cell">
    <%= admin_copyable_original_song_assignment_resolved_value(
          display_track_name,
          label: t('admin.original_song_assignments.track_name')
        ) %>
  </td>
  <% if show_identifiers %>
    <td class="admin-original-song-assignment-jan-cell"><%= track.jan_code %></td>
    <td class="admin-original-song-assignment-isrc-cell"><%= track.isrc %></td>
  <% end %>
  <td class="admin-original-song-search-cell">
    <div class="admin-original-song-search">
      <%= admin_icon(:search) %>
      <input type="search"
             class="input admin-input admin-original-song-search-input"
             placeholder="<%= t('admin.original_song_assignments.search_placeholder') %>"
             autocomplete="off"
             role="combobox"
             aria-autocomplete="list"
             aria-expanded="false"
             aria-haspopup="listbox"
             aria-label="<%= t('admin.original_song_assignments.original_songs_search') %>"
             aria-controls="<%= original_song_listbox_id %>"
             data-admin-original-song-picker-target="input"
             data-action="focus->admin-original-song-picker#focus input->admin-original-song-picker#filter keydown->admin-original-song-picker#keydown keyup->admin-original-song-picker#keyup paste->admin-original-song-picker#paste blur->admin-original-song-picker#blur">
      <div class="admin-original-song-listbox"
           id="<%= original_song_listbox_id %>"
           role="listbox"
           aria-live="polite"
           hidden
           data-admin-original-song-picker-target="listbox"></div>
    </div>
  </td>
  <td class="admin-original-song-selected-cell">
    <%= hidden_field_tag "assignments[#{track.id}][original_song_codes]",
                         selected_original_songs.map(&:code).join(','),
                         data: { admin_original_song_picker_target: 'hidden' } %>
    <div class="admin-original-song-selected" data-admin-original-song-picker-target="selected"></div>
  </td>
</tr>
