<% track_view_path = url_for(request.query_parameters.merge(view: 'tracks', page: nil)) %>
<% album_view_path = url_for(request.query_parameters.merge(view: 'albums', page: nil)) %>

<div class="admin-page-header">
  <div class="admin-page-title">
    <span class="admin-kicker"><%= t('admin.resources.tracks.label') %></span>
    <h1><%= t('admin.original_song_assignments.title') %></h1>
    <p><%= t('admin.original_song_assignments.description') %></p>
  </div>
  <div class="admin-page-actions">
    <%= link_to admin_resource_action_path('tracks', 'auto_assign_original_songs'), class: 'btn admin-btn-primary' do %>
      <%= admin_icon(:check_circle) %>
      <span><%= t('admin.original_song_assignments.auto_preview') %></span>
    <% end %>
    <%= link_to admin_resources_path('tracks'), class: 'btn admin-btn' do %>
      <%= admin_icon(:arrow_left) %>
      <span><%= t('admin.actions.back_to_index') %></span>
    <% end %>
  </div>
</div>

<%= form_with url: admin_track_original_song_assignments_path,
              method: :get,
              class: 'admin-search-form admin-original-song-assignment-search-form' do |form| %>
  <%= form.hidden_field :scroll, value: 'infinite' if admin_infinite_scroll? %>
  <%= form.hidden_field :view, value: @view_mode %>
  <div class="admin-list-toolbar">
    <div class="admin-filter-bar">
      <div class="admin-filter-field">
        <%= form.label :status, t('admin.original_song_assignments.status_label'), class: 'admin-label' %>
        <%= form.select :status,
                        options_for_select([
                          [t('admin.original_song_assignments.status.missing'), 'missing'],
                          [t('admin.original_song_assignments.status.present'), 'present'],
                          [t('admin.original_song_assignments.status.all'), 'all']
                        ], @status),
                        {},
                        class: 'select admin-select',
                        onchange: 'this.form.requestSubmit()' %>
      </div>
      <label class="admin-checkbox-row">
        <%= check_box_tag :show_identifiers, '1', @show_identifiers, onchange: 'this.form.requestSubmit()' %>
        <span><%= t('admin.original_song_assignments.show_identifiers') %></span>
      </label>
    </div>

    <div class="admin-list-controls">
      <div class="admin-search-row">
        <div class="admin-search-input">
          <%= admin_icon(:search) %>
          <%= form.search_field :q, value: @query, placeholder: t('admin.search.placeholder'), class: 'input admin-input' %>
        </div>
        <div class="admin-search-actions">
          <%= form.button type: :submit, class: 'btn admin-btn-primary' do %>
            <%= admin_icon(:search) %>
            <span><%= t('admin.search.submit') %></span>
          <% end %>
          <% if @query.present? || @status != 'missing' || @show_identifiers %>
            <%= link_to admin_track_original_song_assignments_path(
                          view: @view_mode,
                          scroll: (admin_infinite_scroll? ? 'infinite' : 'pagination')
                        ), class: 'btn admin-btn' do %>
              <%= admin_icon(:x) %>
              <span><%= t('admin.search.clear') %></span>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="admin-record-count">
        <% if album_view? %>
          <span><%= t('admin.original_song_assignments.album_results') %></span>
          <strong><%= admin_records_summary(@pagy) %></strong>
          <small><%= t('admin.original_song_assignments.album_track_total', count: number_with_delimiter(@assignment_track_count)) %></small>
        <% else %>
          <span><%= t('admin.table.current_results') %></span>
          <strong><%= admin_records_summary(@pagy) %></strong>
        <% end %>
      </div>
      <div class="admin-original-song-assignment-view-modes">
        <span class="admin-original-song-paste-hint"
              title="<%= t('admin.original_song_assignments.paste_hint') %>">
          <%= t('admin.original_song_assignments.paste_hint') %>
        </span>
        <div class="admin-view-mode-bar" aria-label="<%= t('admin.original_song_assignments.display_mode') %>">
          <span class="admin-view-mode-label"><%= t('admin.original_song_assignments.display_mode') %></span>
          <div class="admin-view-mode-options">
            <% if @status == 'missing' %>
              <%= link_to album_view_path,
                          class: "admin-view-mode-link #{'is-active' if album_view?}",
                          aria: { current: album_view? ? 'true' : nil } do %>
                <%= admin_icon(:collection) %>
                <span><%= t('admin.original_song_assignments.album_view') %></span>
              <% end %>
            <% end %>
            <%= link_to track_view_path,
                        class: "admin-view-mode-link #{'is-active' unless album_view?}",
                        aria: { current: album_view? ? nil : 'true' } do %>
              <%= admin_icon(:list_ordered) %>
              <span><%= t('admin.original_song_assignments.track_view') %></span>
            <% end %>
          </div>
        </div>
        <div class="admin-view-mode-bar" aria-label="<%= t('admin.scroll_mode.label') %>">
          <span class="admin-view-mode-label"><%= t('admin.scroll_mode.label') %></span>
          <div class="admin-view-mode-options">
            <%= link_to admin_scroll_mode_path(:pagination), class: "admin-view-mode-link #{'is-active' unless admin_infinite_scroll?}", aria: { current: admin_infinite_scroll? ? nil : 'true' } do %>
              <%= admin_icon(:list_ordered) %>
              <span><%= t('admin.scroll_mode.pagination') %></span>
            <% end %>
            <%= link_to admin_scroll_mode_path(:infinite), class: "admin-view-mode-link #{'is-active' if admin_infinite_scroll?}", aria: { current: admin_infinite_scroll? ? 'true' : nil } do %>
              <%= admin_icon(:arrow_down_circle) %>
              <span><%= t('admin.scroll_mode.infinite') %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= form_with url: admin_track_original_song_assignments_path(
                q: @query,
                status: @status,
                show_identifiers: (@show_identifiers ? '1' : nil),
                view: @view_mode,
                scroll: (admin_infinite_scroll? ? 'infinite' : 'pagination')
              ),
              method: :patch,
              class: 'admin-original-song-assignment-form',
              data: {
                controller: 'admin-clipboard',
                admin_clipboard_success_message_value: t('admin.toast.copy_success'),
                admin_clipboard_failure_message_value: t('admin.toast.copy_failure')
              } do %>
  <div class="admin-panel admin-table-panel admin-original-song-assignment-panel"
       data-controller="<%= 'admin-infinite-scroll' if admin_infinite_scroll? %>"
       data-admin-infinite-scroll-enabled-value="<%= admin_infinite_scroll? %>"
       data-admin-infinite-scroll-next-url-value="<%= admin_infinite_scroll_next_url(@pagy) %>">
    <div class="admin-panel-header">
      <h2><%= t('admin.original_song_assignments.table_heading') %></h2>
      <%= button_tag type: :submit, class: 'btn admin-btn-primary' do %>
        <%= admin_icon(:check) %>
        <span><%= t('admin.original_song_assignments.save') %></span>
      <% end %>
    </div>
    <div class="admin-table-scroll" data-admin-infinite-scroll-target="container">
      <% if album_view? %>
        <table class="table admin-table admin-original-song-album-table">
          <colgroup>
            <col class="admin-original-song-album-column-jan">
            <col class="admin-original-song-album-column-circle">
            <col class="admin-original-song-album-column-name">
            <col class="admin-original-song-album-column-count">
          </colgroup>
          <thead>
            <tr>
              <th><%= t('admin.attributes.common.jan_code') %></th>
              <th><%= t('admin.attributes.common.circle_name') %></th>
              <th><%= t('admin.original_song_missing_albums.album') %></th>
              <th><%= t('admin.original_song_missing_albums.missing_tracks_count') %></th>
            </tr>
          </thead>
          <tbody data-admin-infinite-scroll-target="rows">
            <% @albums.each do |album| %>
              <%= render 'admin/original_song_assignments/album_group',
                         album:,
                         track_count: @album_track_counts.fetch(album.jan_code, 0),
                         query: @query,
                         show_identifiers: @show_identifiers %>
            <% end %>
            <% if @albums.empty? %>
              <tr>
                <td colspan="4" class="admin-table-empty"><%= t('admin.original_song_assignments.empty') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <table class="table admin-table admin-original-song-assignment-table">
          <colgroup>
            <col class="admin-original-song-column-circle">
            <col class="admin-original-song-column-album">
            <col class="admin-original-song-column-track-number">
            <col class="admin-original-song-column-track-name">
            <% if @show_identifiers %>
              <col class="admin-original-song-column-jan">
              <col class="admin-original-song-column-isrc">
            <% end %>
            <col class="admin-original-song-column-search">
            <col class="admin-original-song-column-selected">
          </colgroup>
          <thead>
            <tr>
              <th><%= t('admin.attributes.common.circle_name') %></th>
              <th><%= t('admin.attributes.common.album_name') %></th>
              <th><%= t('admin.attributes.common.track_number') %></th>
              <th><%= t('admin.attributes.common.name') %></th>
              <% if @show_identifiers %>
                <th><%= t('admin.attributes.common.jan_code') %></th>
                <th><%= t('admin.attributes.common.isrc') %></th>
              <% end %>
              <th><%= t('admin.original_song_assignments.original_songs_search') %></th>
              <th><%= t('admin.original_song_assignments.assigned_original_songs') %></th>
            </tr>
          </thead>
          <tbody data-admin-infinite-scroll-target="rows">
            <%= render partial: 'admin/original_song_assignments/track_row',
                       collection: @tracks,
                       as: :track,
                       locals: { compact: false, track_resource: @track_resource, show_identifiers: @show_identifiers } %>
            <% if @tracks.empty? %>
              <tr>
                <td colspan="<%= @show_identifiers ? 8 : 6 %>" class="admin-table-empty"><%= t('admin.original_song_assignments.empty') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% if admin_infinite_scroll? && @pagy.next.present? %>
        <div class="admin-infinite-scroll-sentinel" data-admin-infinite-scroll-target="sentinel" aria-hidden="true"></div>
      <% end %>
    </div>
    <% if admin_infinite_scroll? %>
      <div class="admin-infinite-scroll-footer">
        <div class="admin-infinite-scroll-status"
             data-admin-infinite-scroll-target="status"
             data-loading-text="<%= t('admin.scroll_mode.loading') %>"
             data-ready-text="<%= t('admin.scroll_mode.ready') %>"
             data-complete-text="<%= t('admin.scroll_mode.complete') %>"
             data-error-text="<%= t('admin.scroll_mode.error') %>">
          <%= @pagy.next.present? ? t('admin.scroll_mode.ready') : t('admin.scroll_mode.complete') %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% unless admin_infinite_scroll? %>
  <%= admin_pagination(@pagy) %>
<% end %>
